{
  "name": "devdev",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "devdev — indie games portal. Steam-like UI, static-first. Houses BLOODVOLT v1.0 ULTIMATE and future titles.",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "npm run validate && astro build",
    "preview": "astro preview",
    "validate": "tsx scripts/validate-manifests.ts",
    "fetch:manifests": "tsx scripts/fetch-manifests.ts",
    "lint": "biome lint src scripts",
    "format": "biome format --write src scripts",
    "deploy": "npm run build && firebase deploy --only hosting",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.2",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "astro": "^5.0.0",
    "three": "^0.184.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/node": "^22.0.0",
    "@types/three": "^0.184.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
