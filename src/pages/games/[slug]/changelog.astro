---
// Per-game changelog page. Reads manifest.changelog. Static.

import { getCollection } from 'astro:content';
import BaseLayout from '@components/layout/BaseLayout.astro';
import ContentSection from '@components/layout/ContentSection.astro';
import Tag from '@components/primitives/Tag.astro';
import Button from '@components/primitives/Button.astro';
import { gameThemeStyle } from '@lib/theme';
import { formatDate } from '@lib/format';
import { route } from '@lib/routes';

export async function getStaticPaths() {
  const games = await getCollection('games');
  return games
    .filter((g) => (g.data.changelog?.length ?? 0) > 0)
    .map((g) => ({ params: { slug: g.id }, props: { manifest: g.data } }));
}

const { manifest } = Astro.props;
const log = manifest.changelog ?? [];
const seo = {
  title: `${manifest.title} — Changelog`,
  description: `Patch history for ${manifest.title}.`,
  canonical: `${Astro.site?.toString() ?? ''}/games/${manifest.slug}/changelog`,
};
const theme = gameThemeStyle(manifest);
---

<BaseLayout seo={seo} themeStyle={theme} bodyDataGame={manifest.slug}>
  <ContentSection eyebrow={manifest.title} title="CHANGELOG">
    <div class="back">
      <Button href={route.game(manifest.slug)} variant="ghost" size="sm">← BACK TO GAME</Button>
    </div>
    <ol class="cl">
      {log.map((entry, i) => (
        <li class={`cl__entry ${i === 0 ? 'cl__entry--latest' : ''}`}>
          <div class="cl__head">
            {i === 0 && <Tag variant="accent" size="sm">LATEST</Tag>}
            <span class="cl__ver">{entry.version}</span>
            <time class="cl__date">{formatDate(entry.date)}</time>
          </div>
          <p class="cl__sum">{entry.summary}</p>
          {entry.highlights.length > 0 && (
            <ul class="cl__highlights">
              {entry.highlights.map((h) => <li>{h}</li>)}
            </ul>
          )}
        </li>
      ))}
    </ol>
  </ContentSection>
</BaseLayout>

<style>
  .back { margin-bottom: var(--space-4); }
  .cl { display: flex; flex-direction: column; gap: var(--space-4); list-style: none; padding: 0; }
  .cl__entry {
    padding: var(--space-4);
    border: 1px solid var(--border-0);
    background: var(--bg-1);
    border-radius: var(--radius-3);
    border-left: 3px solid var(--border-1);
  }
  .cl__entry--latest { border-left-color: var(--accent); }
  .cl__head { display: flex; align-items: center; gap: var(--space-2); margin-bottom: var(--space-2); }
  .cl__ver {
    font-family: var(--font-mono);
    font-weight: 800;
    color: var(--accent);
    letter-spacing: var(--tracking-wide);
  }
  .cl__date {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: var(--fs-1);
    color: var(--text-2);
  }
  .cl__sum { color: var(--text-1); margin-bottom: var(--space-2); }
  .cl__highlights {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .cl__highlights li {
    padding: 6px 12px;
    font-family: var(--font-mono);
    font-size: var(--fs-2);
    color: var(--text-1);
    background: var(--bg-0);
    border: 1px solid var(--border-0);
    border-left: 2px solid var(--accent);
    border-radius: var(--radius-2);
  }
</style>
