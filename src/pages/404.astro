---
import BaseLayout from '@components/layout/BaseLayout.astro';
import Button from '@components/primitives/Button.astro';

const seo = {
  title: '404 — devdev',
  description: 'Page not found.',
};
---

<BaseLayout seo={seo}>
  <div class="not-found">
    <div class="not-found__code">404</div>
    <h1 class="not-found__title">Signal lost.</h1>
    <p class="not-found__body">That page doesn't exist on devdev.</p>
    <Button href="/" variant="primary">Return home</Button>
  </div>
</BaseLayout>

<style>
  .not-found {
    text-align: center;
    padding: var(--space-9) var(--space-4);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }
  .not-found__code {
    font-family: var(--font-mono);
    font-size: 96px;
    font-weight: 800;
    color: var(--accent);
    letter-spacing: var(--tracking-tight);
    line-height: 1;
  }
  .not-found__title { font-size: var(--fs-6); }
  .not-found__body { color: var(--text-2); margin-bottom: var(--space-3); }
</style>
