---
// BackgroundShader — drifting low-poly icosahedrons in chassis colors. Pure Three.js
// island; runs only on client:visible so non-home routes don't pay the cost.
// Honors prefers-reduced-motion (renders one frame and stops).
---

<canvas id="bv-bg" class="bv-bg" aria-hidden="true"></canvas>

<style>
  .bv-bg {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
    opacity: 0.55;
    mix-blend-mode: screen;
  }
  /* Sit content above the canvas */
  :global(body > *:not(.bv-bg)) { position: relative; z-index: 1; }
</style>

<script>
  import * as THREE from 'three';

  const canvas = document.getElementById('bv-bg') as HTMLCanvasElement | null;
  if (!canvas) throw new Error('bv-bg canvas missing');

  const reduce = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches ?? false;

  const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
  renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.5));
  renderer.setClearColor(0x000000, 0);

  const scene = new THREE.Scene();
  const camera = new THREE.PerspectiveCamera(55, 1, 0.1, 200);
  camera.position.set(0, 0, 30);

  // Chassis colors lifted from BLOODVOLT
  const COLORS = [0x00f0ff, 0xff006e, 0x9d00ff, 0xc1ff00, 0xffb400, 0x00ff9d];

  // Procedural drifting icosahedrons — low-poly, wireframe-tinted.
  const COUNT = 14;
  type Drifter = { mesh: THREE.Mesh; speed: number; rotSpeed: THREE.Vector3 };
  const drifters: Drifter[] = [];

  for (let i = 0; i < COUNT; i++) {
    const colorHex = COLORS[i % COLORS.length] ?? 0xffffff;
    const radius = 1.2 + Math.random() * 2.4;
    const geom = new THREE.IcosahedronGeometry(radius, 0);
    const mat = new THREE.MeshBasicMaterial({
      color: colorHex,
      wireframe: true,
      transparent: true,
      opacity: 0.45,
    });
    const mesh = new THREE.Mesh(geom, mat);
    mesh.position.set(
      (Math.random() - 0.5) * 60,
      (Math.random() - 0.5) * 36,
      -10 - Math.random() * 30,
    );
    scene.add(mesh);
    drifters.push({
      mesh,
      speed: 0.3 + Math.random() * 0.6,
      rotSpeed: new THREE.Vector3(
        (Math.random() - 0.5) * 0.4,
        (Math.random() - 0.5) * 0.4,
        (Math.random() - 0.5) * 0.2,
      ),
    });
  }

  function resize(): void {
    const w = window.innerWidth;
    const h = window.innerHeight;
    renderer.setSize(w, h, false);
    camera.aspect = w / h;
    camera.updateProjectionMatrix();
  }
  resize();
  window.addEventListener('resize', resize, { passive: true });

  let raf = 0;
  let lastT = performance.now();
  function tick(now: number): void {
    const dt = (now - lastT) * 0.001;
    lastT = now;
    for (const d of drifters) {
      d.mesh.rotation.x += d.rotSpeed.x * dt;
      d.mesh.rotation.y += d.rotSpeed.y * dt;
      d.mesh.rotation.z += d.rotSpeed.z * dt;
      d.mesh.position.y += d.speed * dt * 0.4;
      if (d.mesh.position.y > 22) d.mesh.position.y = -22;
    }
    renderer.render(scene, camera);
    if (!reduce) raf = requestAnimationFrame(tick);
  }
  raf = requestAnimationFrame(tick);

  // Cleanup if Astro view-transitions ever land
  document.addEventListener('astro:before-swap', () => {
    cancelAnimationFrame(raf);
    renderer.dispose();
  });
</script>
