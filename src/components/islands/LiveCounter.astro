---
// LiveCounter — synthetic "N playing now" counter. Deterministic per-minute base
// + small jitter, so two visitors at the same instant see the same number. Updates
// every 3s. Replace with real backend telemetry when auth lands.

interface Props {
  baseLow?: number;
  baseHigh?: number;
  label?: string;
}
const { baseLow = 14, baseHigh = 86, label = 'PLAYING NOW' } = Astro.props as Props;
---

<div class="lc" data-low={baseLow} data-high={baseHigh}>
  <span class="lc__dot"></span>
  <span class="lc__num">—</span>
  <span class="lc__label">{label}</span>
</div>

<style>
  .lc {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border-radius: var(--radius-pill);
    background: var(--bg-1);
    border: 1px solid var(--border-0);
    font-family: var(--font-mono);
    font-size: var(--fs-1);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
  }
  .lc__dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: var(--success);
    box-shadow: 0 0 8px var(--success);
    animation: pulse 1.6s ease-in-out infinite;
  }
  .lc__num { font-weight: 800; color: var(--text-0); font-size: var(--fs-2); }
  .lc__label { color: var(--text-2); }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.55; transform: scale(0.9); }
  }
  @media (prefers-reduced-motion: reduce) {
    .lc__dot { animation: none; }
  }
</style>

<script>
  // Mulberry32 — deterministic per-minute seed so the count is shared across visitors.
  function mulberry32(seed: number): () => number {
    return () => {
      seed = (seed + 0x6d2b79f5) | 0;
      let t = seed;
      t = Math.imul(t ^ (t >>> 15), t | 1);
      t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }

  document.querySelectorAll<HTMLElement>('.lc').forEach((el) => {
    const num = el.querySelector<HTMLElement>('.lc__num');
    if (!num) return;
    const low = Number(el.dataset.low ?? 14);
    const high = Number(el.dataset.high ?? 86);

    function update(): void {
      const minute = Math.floor(Date.now() / 60_000);
      const r = mulberry32(minute);
      // Smooth diurnal-ish curve via sin
      const hour = new Date().getUTCHours();
      const peak = Math.sin(((hour - 6) / 24) * Math.PI * 2) * 0.5 + 0.5; // 0–1
      const base = low + (high - low) * (0.4 + peak * 0.5);
      const jitter = (r() - 0.5) * 6;
      const n = Math.max(low, Math.round(base + jitter));
      if (num) num.textContent = String(n);
    }
    update();
    setInterval(update, 3000);
  });
</script>
