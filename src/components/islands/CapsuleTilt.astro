---
// CapsuleTilt — wraps a slot in a perspective container that 3D-tilts on mouse move.
// Zero-cost when no pointer present (touch, keyboard nav), respects reduced-motion.

interface Props { intensity?: number }
const { intensity = 8 } = Astro.props as Props;
---

<div class="tilt" data-intensity={intensity}>
  <slot />
</div>

<style>
  .tilt { perspective: 1200px; transform-style: preserve-3d; }
  .tilt > :global(*) {
    transition: transform 200ms cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
  }
  @media (prefers-reduced-motion: reduce) {
    .tilt > :global(*) { transition: none; }
  }
</style>

<script>
  const reduce = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches ?? false;
  if (!reduce) {
    document.querySelectorAll<HTMLElement>('.tilt').forEach((wrap) => {
      const inner = wrap.firstElementChild as HTMLElement | null;
      if (!inner) return;
      const intensity = Number(wrap.dataset.intensity ?? 8);
      wrap.addEventListener('mousemove', (e: MouseEvent) => {
        const r = wrap.getBoundingClientRect();
        const px = (e.clientX - r.left) / r.width - 0.5;
        const py = (e.clientY - r.top) / r.height - 0.5;
        inner.style.transform = `rotateY(${px * intensity}deg) rotateX(${-py * intensity}deg) scale(1.02)`;
      });
      wrap.addEventListener('mouseleave', () => {
        inner.style.transform = '';
      });
    });
  }
</script>
