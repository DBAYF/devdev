---
import type { GameManifest } from '@content/config';
import Tag from '../primitives/Tag.astro';

interface Props { manifest: GameManifest; }
const { manifest } = Astro.props as Props;
---

<section class="hero">
  {manifest.trailerLoop ? (
    <video
      class="hero__bg"
      src={manifest.trailerLoop}
      poster={manifest.capsules.hero}
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
    />
  ) : (
    <img class="hero__bg" src={manifest.capsules.hero} alt="" loading="eager" decoding="async" />
  )}
  <div class="hero__shade" />
  <div class="hero__inner">
    <div class="hero__tags">
      {manifest.subtitle && <Tag variant="accent">{manifest.subtitle}</Tag>}
      <Tag variant="neutral">{manifest.rating}</Tag>
    </div>
    <h1 class="hero__title">{manifest.title}</h1>
    <p class="hero__tagline">{manifest.tagline}</p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    aspect-ratio: 16 / 7;
    width: 100%;
    border-radius: var(--radius-3);
    overflow: hidden;
    background: var(--bg-game, var(--bg-1));
    margin-bottom: var(--space-5);
    border: 1px solid var(--border-1);
  }
  .hero__bg {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
  }
  .hero__shade {
    position: absolute; inset: 0;
    background:
      linear-gradient(to top, rgba(0,0,0,0.85) 0%, transparent 55%),
      linear-gradient(to right, rgba(0,0,0,0.4) 0%, transparent 50%);
  }
  .hero__inner {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    padding: var(--space-6);
    display: flex; flex-direction: column; gap: var(--space-3);
  }
  .hero__tags { display: flex; gap: var(--space-2); }
  .hero__title {
    font-size: var(--fs-8);
    color: #fff;
    text-shadow: 0 4px 16px rgba(0,0,0,0.7);
  }
  .hero__tagline {
    font-family: var(--font-mono);
    font-size: var(--fs-3);
    color: var(--text-1);
    max-width: 720px;
    text-shadow: 0 2px 6px rgba(0,0,0,0.8);
  }
  @media (max-width: 768px) {
    .hero { aspect-ratio: 16 / 10; }
    .hero__title { font-size: var(--fs-6); }
    .hero__tagline { font-size: var(--fs-2); }
    .hero__inner { padding: var(--space-4); }
  }
</style>
