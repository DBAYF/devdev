---
import type { GameManifest } from '@content/config';
import Tag from '../primitives/Tag.astro';

interface Props { manifest: GameManifest; }
const { manifest } = Astro.props as Props;
const ach = manifest.achievements ?? [];
const total = ach.length;
const rare = ach.filter((a) => a.rare).length;
---

{total > 0 && (
  <section class="ag">
    <header class="ag__head">
      <div>
        <div class="ag__eyebrow">{total} ACHIEVEMENTS · {rare} RARE</div>
        <h3 class="ag__title">UNLOCK CONDITIONS</h3>
      </div>
    </header>
    <div class="ag__grid">
      {ach.map((a) => (
        <article class={`ag__card ${a.rare ? 'ag__card--rare' : ''}`}>
          <div class="ag__name">
            {a.name}
            {a.rare && <Tag variant="warn" size="sm">RARE</Tag>}
          </div>
          <div class="ag__desc">{a.desc}</div>
          {a.target && a.target > 1 && (
            <div class="ag__target">TARGET · {a.target.toLocaleString()}</div>
          )}
        </article>
      ))}
    </div>
  </section>
)}

<style>
  .ag__head { margin-bottom: var(--space-4); }
  .ag__eyebrow {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 4px;
  }
  .ag__title { font-size: var(--fs-5); }
  .ag__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: var(--space-3);
  }
  .ag__card {
    padding: var(--space-3) var(--space-4);
    background: var(--bg-1);
    border: 1px solid var(--border-0);
    border-radius: var(--radius-3);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .ag__card--rare { border-color: var(--warn); }
  .ag__name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--fs-3);
    color: var(--text-0);
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .ag__desc { font-size: var(--fs-2); color: var(--text-1); line-height: var(--lh-snug); }
  .ag__target {
    margin-top: 4px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: var(--tracking-wider);
    color: var(--accent);
  }
</style>
