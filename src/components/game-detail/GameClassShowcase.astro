---
import type { GameManifest } from '@content/config';

interface Props { manifest: GameManifest; }
const { manifest } = Astro.props as Props;
const classes = manifest.classShowcase ?? [];
---

{classes.length > 0 && (
  <section class="cs">
    <header class="cs__head">
      <div class="cs__eyebrow">CHASSIS</div>
      <h3 class="cs__title">PICK YOUR LINEAGE</h3>
      <p class="cs__sub">Six chassis. Each branches into a 4-tier class tree with distinct
        weapon mods, role identity, and signature ult.</p>
    </header>
    <div class="cs__grid">
      {classes.map((c) => (
        <article class="cs__card" style={`--c:${c.color}`}>
          <div class="cs__icon" aria-hidden="true">
            <svg viewBox="0 0 100 100" width="64" height="64">
              <polygon points="50,18 80,55 70,90 30,90 20,55" fill="none" stroke={c.color} stroke-width="3"/>
              <polygon points="50,32 68,58 60,80 40,80 32,58" fill={c.color} fill-opacity="0.15" stroke={c.color} stroke-width="1.5"/>
            </svg>
          </div>
          <div class="cs__name">{c.name}</div>
          <div class="cs__role">{c.role} · {c.weapon}</div>
          {c.bio && <p class="cs__bio">{c.bio}</p>}
        </article>
      ))}
    </div>
  </section>
)}

<style>
  .cs__head { margin-bottom: var(--space-4); }
  .cs__eyebrow {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 4px;
  }
  .cs__title { font-size: var(--fs-5); margin-bottom: var(--space-2); }
  .cs__sub { color: var(--text-2); max-width: 60ch; font-size: var(--fs-2); }
  .cs__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: var(--space-3);
  }
  .cs__card {
    padding: var(--space-4);
    background: var(--bg-1);
    border: 1px solid var(--border-0);
    border-radius: var(--radius-3);
    transition: border-color var(--dur-1) var(--ease-out), transform var(--dur-1) var(--ease-out);
  }
  .cs__card:hover { border-color: var(--c); transform: translateY(-2px); }
  .cs__icon { margin-bottom: var(--space-2); filter: drop-shadow(0 0 6px var(--c)); }
  .cs__name {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: var(--fs-4);
    color: var(--c);
    letter-spacing: var(--tracking-tight);
    margin-bottom: 2px;
  }
  .cs__role {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--text-2);
    margin-bottom: var(--space-2);
  }
  .cs__bio {
    font-size: var(--fs-2);
    color: var(--text-1);
    line-height: var(--lh-snug);
  }
</style>
