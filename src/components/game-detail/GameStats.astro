---
import type { GameManifest } from '@content/config';
import StatPill from '../primitives/StatPill.astro';

interface Props { manifest: GameManifest; }
const { manifest } = Astro.props as Props;
const entries = Object.entries(manifest.stats);
---

{entries.length > 0 && (
  <div class="stats">
    <h3 class="stats__head">BY THE NUMBERS</h3>
    <div class="stats__grid">
      {entries.map(([k, v]) => (
        <StatPill label={k.replace(/([A-Z])/g, ' $1')} value={v} />
      ))}
    </div>
  </div>
)}

<style>
  .stats__head {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: var(--space-3);
  }
  .stats__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
    gap: var(--space-3);
  }
</style>
