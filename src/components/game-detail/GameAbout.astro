---
import type { GameManifest } from '@content/config';
import Tag from '../primitives/Tag.astro';

interface Props { manifest: GameManifest; }
const { manifest } = Astro.props as Props;
---

<div class="about">
  <h3 class="about__head">ABOUT</h3>
  <p class="about__body">{manifest.description}</p>
  <div class="about__tags">
    {manifest.genre.map((g) => <Tag variant="accent">{g}</Tag>)}
    {manifest.tags.map((t) => <Tag variant="neutral">{t}</Tag>)}
  </div>
</div>

<style>
  .about__head {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: var(--space-2);
  }
  .about__body {
    font-size: var(--fs-3);
    line-height: var(--lh-normal);
    color: var(--text-1);
    margin-bottom: var(--space-4);
  }
  .about__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
</style>
