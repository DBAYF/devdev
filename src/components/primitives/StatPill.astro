---
// StatPill — label/value pair. Used for game stats grids.

interface Props {
  label: string;
  value: string | number;
}

const { label, value } = Astro.props as Props;
---

<div class="pill">
  <div class="pill__value">{value}</div>
  <div class="pill__label">{label}</div>
</div>

<style>
  .pill {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    padding: var(--space-3) var(--space-4);
    background: var(--bg-1);
    border: 1px solid var(--border-0);
    border-radius: var(--radius-3);
    min-width: 96px;
  }
  .pill__value {
    font-family: var(--font-mono);
    font-size: var(--fs-5);
    font-weight: 800;
    color: var(--accent);
    line-height: 1;
  }
  .pill__label {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--text-2);
  }
</style>
