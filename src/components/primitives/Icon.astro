---
// Icon — inline SVG by name. Add new icons here, ID-keyed. Single sprite source.

interface Props {
  name: 'home' | 'library' | 'news' | 'profile' | 'about' | 'play' | 'external' | 'star';
  size?: number;
  ariaHidden?: boolean;
}

const { name, size = 16, ariaHidden = true } = Astro.props as Props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={ariaHidden}
>
  {name === 'home'    && <path d="M3 11.5 12 4l9 7.5V20a1 1 0 0 1-1 1h-5v-7h-6v7H4a1 1 0 0 1-1-1z" />}
  {name === 'library' && <><rect x="3" y="4" width="6" height="16" rx="1" /><rect x="11" y="4" width="6" height="16" rx="1" /><path d="M19 6l3 1-3 13-3-1z" /></>}
  {name === 'news'    && <><path d="M5 5h14a1 1 0 0 1 1 1v12a2 2 0 0 1-2 2H4V6a1 1 0 0 1 1-1z" /><path d="M8 9h8M8 13h8M8 17h5" /></>}
  {name === 'profile' && <><circle cx="12" cy="8" r="4" /><path d="M4 21a8 8 0 0 1 16 0" /></>}
  {name === 'about'   && <><circle cx="12" cy="12" r="9" /><path d="M12 8v4M12 16h.01" /></>}
  {name === 'play'    && <path d="M6 4l14 8-14 8z" />}
  {name === 'external'&& <><path d="M14 4h6v6" /><path d="M20 4 10 14" /><path d="M20 14v6H4V4h6" /></>}
  {name === 'star'    && <path d="M12 3l2.7 6 6.3.6-4.8 4.2 1.5 6.2L12 16.8 6.3 20l1.5-6.2L3 9.6 9.3 9z" />}
</svg>
