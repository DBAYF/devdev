---
import { getCollection } from 'astro:content';
import { PRIMARY_NAV } from '@data/nav';
import { GAMES } from '@data/games-registry';
import Icon from '../primitives/Icon.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));

// Featured game → persistent PLAY CTA on the right of the nav.
const games = await getCollection('games');
const featuredSlug = GAMES.find((g) => g.featured)?.slug;
const featured = featuredSlug ? games.find((g) => g.id === featuredSlug)?.data : undefined;
---

<nav class="nav" aria-label="Primary">
  <div class="nav__inner">
    <a href="/" class="nav__brand" aria-label="devdev home">
      <span class="nav__logo">devdev</span>
    </a>
    <ul class="nav__list">
      {PRIMARY_NAV.map((link) => (
        <li>
          <a
            href={link.href}
            class={`nav__link ${isActive(link.href) ? 'nav__link--active' : ''}`}
            aria-current={isActive(link.href) ? 'page' : undefined}
          >
            {link.icon && <Icon name={link.icon} size={14} />}
            <span>{link.label}</span>
          </a>
        </li>
      ))}
    </ul>
    {featured && (
      <a
        class="nav__play"
        href={featured.playUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Play ${featured.title} (opens in new tab)`}
      >
        ▸ PLAY
      </a>
    )}
  </div>
</nav>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg-0) 80%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border-0);
  }
  .nav__inner {
    max-width: var(--content-w);
    margin: 0 auto;
    height: var(--nav-h);
    padding: 0 var(--space-4);
    display: flex;
    align-items: center;
    gap: var(--space-5);
  }
  .nav__brand { display: flex; align-items: center; }
  .nav__logo {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: var(--fs-4);
    letter-spacing: var(--tracking-tight);
    color: var(--accent);
  }
  .nav__list { display: flex; gap: var(--space-1); flex: 1; }
  .nav__link {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: 6px 12px;
    border-radius: var(--radius-2);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: var(--fs-1);
    letter-spacing: var(--tracking-wider);
    color: var(--text-2);
    transition: color var(--dur-1) var(--ease-out), background-color var(--dur-1) var(--ease-out);
  }
  .nav__link:hover { color: var(--text-0); background: var(--bg-1); }
  .nav__link--active { color: var(--accent); background: var(--accent-soft); }

  /* Persistent PLAY CTA — always visible, always reachable. */
  .nav__play {
    padding: 8px 16px;
    background: var(--accent);
    color: var(--bg-0);
    font-family: var(--font-mono);
    font-weight: 800;
    font-size: var(--fs-1);
    letter-spacing: var(--tracking-wider);
    border-radius: var(--radius-2);
    transition: background var(--dur-1) var(--ease-out), transform var(--dur-1) var(--ease-out);
    flex-shrink: 0;
  }
  .nav__play:hover {
    background: color-mix(in srgb, var(--accent) 86%, white);
    transform: translateY(-1px);
  }

  @media (max-width: 600px) {
    .nav__link span { display: none; }
    .nav__inner { gap: var(--space-2); }
    .nav__play { padding: 6px 12px; }
  }
</style>
