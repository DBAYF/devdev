---
// CapsuleCatalog — 460×215 grid card. Used on home + library.

import type { GameManifest } from '@content/config';
import { route } from '@lib/routes';

interface Props {
  manifest: GameManifest;
}
const { manifest } = Astro.props as Props;
---

<a
  class="cap"
  href={route.game(manifest.slug)}
  style={`--game-accent:${manifest.accentColor};--game-dark:${manifest.darkColor};`}
>
  <img
    class="cap__art"
    src={manifest.capsules.catalog}
    alt={`${manifest.title} catalog art`}
    loading="lazy"
    decoding="async"
    width="460"
    height="215"
  />
  <span
    class="cap__play js-play"
    data-href={manifest.playUrl}
    role="button"
    tabindex="0"
    aria-label={`Play ${manifest.title} (opens in new tab)`}
  >▸ PLAY</span>
  <div class="cap__meta">
    <div class="cap__title">{manifest.title}</div>
    <div class="cap__sub">{manifest.genre.slice(0, 2).join(' · ')}</div>
  </div>
</a>

<style>
  .cap {
    --tint: var(--game-accent, var(--accent));
    --bg: var(--game-dark, var(--bg-1));
    display: block;
    background: var(--bg);
    border: 1px solid var(--border-0);
    border-radius: var(--radius-3);
    overflow: hidden;
    transition: transform var(--dur-2) var(--ease-out),
      border-color var(--dur-2) var(--ease-out),
      box-shadow var(--dur-2) var(--ease-out);
  }
  .cap:hover {
    transform: translateY(-2px);
    border-color: var(--tint);
    box-shadow: 0 8px 24px color-mix(in srgb, var(--tint) 22%, transparent);
  }
  .cap__art {
    aspect-ratio: 460 / 215;
    width: 100%;
    object-fit: cover;
    transition: transform var(--dur-3) var(--ease-out);
  }
  .cap:hover .cap__art { transform: scale(1.05); }
  .cap__meta {
    padding: var(--space-3) var(--space-4);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .cap__title {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: var(--fs-4);
    color: var(--text-0);
    letter-spacing: var(--tracking-tight);
  }
  .cap__sub {
    font-family: var(--font-mono);
    font-size: var(--fs-1);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--text-2);
  }

  /* PLAY pill — sits over the art top-right, always visible. Click opens game in new tab. */
  .cap__play {
    position: absolute;
    top: 10px; right: 10px;
    z-index: 2;
    padding: 8px 12px;
    background: var(--tint);
    color: #060911;
    font-family: var(--font-mono);
    font-weight: 800;
    font-size: 11px;
    letter-spacing: var(--tracking-wider);
    border-radius: var(--radius-2);
    box-shadow: 0 4px 16px color-mix(in srgb, var(--tint) 40%, transparent);
    cursor: pointer;
    user-select: none;
    transform: translateY(-2px);
    opacity: 0.95;
    transition: opacity var(--dur-1) var(--ease-out), transform var(--dur-1) var(--ease-out), box-shadow var(--dur-1) var(--ease-out);
  }
  .cap__play:hover, .cap__play:focus-visible {
    opacity: 1;
    transform: translateY(0);
    box-shadow: 0 6px 24px color-mix(in srgb, var(--tint) 60%, transparent);
    outline: none;
  }
</style>

<script>
  // PLAY pills: stop the click from bubbling up to the parent capsule link, then
  // open the game in a new tab. Keyboard (Enter/Space) too.
  document.querySelectorAll<HTMLElement>('.js-play').forEach((el) => {
    const launch = (e: Event) => {
      e.preventDefault();
      e.stopPropagation();
      const href = el.dataset.href;
      if (href) window.open(href, '_blank', 'noopener,noreferrer');
    };
    el.addEventListener('click', launch);
    el.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Enter' || e.key === ' ') launch(e);
    });
  });
</script>
