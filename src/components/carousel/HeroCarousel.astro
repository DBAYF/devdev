---
// HeroCarousel — auto-rotating spotlight slots. Each slot carries its own art +
// title + subline + cta. Auto-advance every 6s; pauses on hover; click-jumps to slide.

export interface HeroSlide {
  id: string;
  eyebrow: string;
  title: string;
  subline: string;
  ctaLabel: string;
  ctaHref: string;
  ctaTarget?: '_self' | '_blank';
  bgUrl: string;
  accentColor: string;
  darkColor: string;
}

interface Props {
  slides: HeroSlide[];
  intervalMs?: number;
}

const { slides, intervalMs = 6000 } = Astro.props as Props;
---

<div class="hc" data-interval={intervalMs}>
  <div class="hc__slides">
    {slides.map((s, i) => (
      <a
        class={`hc__slide ${i === 0 ? 'hc__slide--active' : ''}`}
        href={s.ctaHref}
        target={s.ctaTarget ?? '_self'}
        data-i={i}
        style={`--slide-accent:${s.accentColor};--slide-dark:${s.darkColor};`}
      >
        <img class="hc__art" src={s.bgUrl} alt="" loading={i === 0 ? 'eager' : 'lazy'} />
        <div class="hc__shade" />
        <div class="hc__content">
          <div class="hc__eyebrow">{s.eyebrow}</div>
          <h2 class="hc__title">{s.title}</h2>
          <p class="hc__sub">{s.subline}</p>
          <span class="hc__cta">{s.ctaLabel} →</span>
        </div>
      </a>
    ))}
  </div>
  {slides.length > 1 && (
    <div class="hc__dots" role="tablist">
      {slides.map((s, i) => (
        <button
          class={`hc__dot ${i === 0 ? 'hc__dot--active' : ''}`}
          data-i={i}
          aria-label={`Go to slide ${i + 1} (${s.title})`}
          role="tab"
        />
      ))}
    </div>
  )}
</div>

<style>
  .hc { position: relative; aspect-ratio: 21 / 9; border-radius: var(--radius-3); overflow: hidden; border: 1px solid var(--border-1); background: var(--bg-1); }
  .hc__slides { position: absolute; inset: 0; }
  .hc__slide {
    position: absolute; inset: 0;
    display: block;
    opacity: 0;
    transition: opacity 600ms var(--ease-in-out);
    pointer-events: none;
  }
  .hc__slide--active { opacity: 1; pointer-events: auto; }
  .hc__art { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hc__shade {
    position: absolute; inset: 0;
    background:
      linear-gradient(to top, rgba(0,0,0,0.85) 0%, transparent 55%),
      linear-gradient(to right, rgba(0,0,0,0.4) 0%, transparent 50%);
  }
  .hc__content {
    position: absolute; left: 0; right: 0; bottom: 0;
    padding: var(--space-6);
    display: flex; flex-direction: column; gap: var(--space-2);
  }
  .hc__eyebrow {
    font-family: var(--font-mono);
    font-size: var(--fs-1);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--slide-accent);
  }
  .hc__title {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: var(--fs-7);
    color: #fff;
    text-shadow: 0 4px 16px rgba(0,0,0,0.7);
  }
  .hc__sub {
    font-family: var(--font-mono);
    font-size: var(--fs-2);
    color: var(--text-1);
    max-width: 720px;
    text-shadow: 0 2px 6px rgba(0,0,0,0.8);
  }
  .hc__cta {
    margin-top: 4px;
    font-family: var(--font-mono);
    font-weight: 800;
    font-size: var(--fs-2);
    letter-spacing: var(--tracking-wider);
    color: var(--slide-accent);
    text-transform: uppercase;
  }
  .hc__dots {
    position: absolute; bottom: var(--space-3); right: var(--space-4);
    display: flex; gap: 8px;
    z-index: 2;
  }
  .hc__dot {
    width: 28px; height: 4px;
    background: rgba(255, 255, 255, 0.25);
    border-radius: 2px;
    cursor: pointer;
    transition: background var(--dur-1) var(--ease-out);
  }
  .hc__dot--active { background: var(--accent); }
  .hc__dot:hover { background: rgba(255, 255, 255, 0.5); }
  @media (max-width: 768px) {
    .hc { aspect-ratio: 16 / 10; }
    .hc__title { font-size: var(--fs-5); }
    .hc__sub { font-size: var(--fs-1); }
    .hc__content { padding: var(--space-4); }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.hc').forEach((root) => {
    const slides = root.querySelectorAll<HTMLElement>('.hc__slide');
    const dots = root.querySelectorAll<HTMLElement>('.hc__dot');
    if (slides.length <= 1) return;
    const interval = Number(root.dataset.interval ?? 6000);
    let i = 0;
    let timer = 0;
    const reduce = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches ?? false;

    function show(idx: number): void {
      slides.forEach((s, k) => s.classList.toggle('hc__slide--active', k === idx));
      dots.forEach((d, k) => d.classList.toggle('hc__dot--active', k === idx));
      i = idx;
    }
    function next(): void { show((i + 1) % slides.length); }
    function start(): void {
      if (reduce) return;
      stop();
      timer = window.setInterval(next, interval);
    }
    function stop(): void { if (timer) { clearInterval(timer); timer = 0; } }

    dots.forEach((d) => {
      d.addEventListener('click', (e) => {
        e.preventDefault();
        const k = Number((e.currentTarget as HTMLElement).dataset.i);
        show(k);
        start();
      });
    });
    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);
    start();
  });
</script>
