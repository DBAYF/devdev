---
// ScreenshotCarousel — CSS-only horizontal scroll-snap. Zero JS.
// For accessibility, screenshots are also reachable via keyboard arrows in browsers
// that scroll on focus.

interface Props {
  images: readonly string[];
  alt: string;
}
const { images, alt } = Astro.props as Props;
---

<div class="ssc">
  <div class="ssc__track" role="region" aria-label={`${alt} screenshots`}>
    {images.map((src, i) => (
      <figure class="ssc__slide">
        <img
          src={src}
          alt={`${alt} screenshot ${i + 1}`}
          loading={i === 0 ? 'eager' : 'lazy'}
          decoding="async"
        />
      </figure>
    ))}
  </div>
</div>

<style>
  .ssc { position: relative; }
  .ssc__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    gap: var(--space-3);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding: var(--space-4);
    padding-bottom: var(--space-3);
    /* hide scrollbar */
    scrollbar-width: thin;
    scrollbar-color: var(--border-1) transparent;
  }
  .ssc__track::-webkit-scrollbar { height: 8px; }
  .ssc__track::-webkit-scrollbar-thumb { background: var(--border-1); border-radius: 4px; }
  .ssc__slide {
    scroll-snap-align: start;
    margin: 0;
    border-radius: var(--radius-3);
    overflow: hidden;
    border: 1px solid var(--border-0);
    background: var(--bg-1);
    aspect-ratio: 16 / 9;
  }
  .ssc__slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
